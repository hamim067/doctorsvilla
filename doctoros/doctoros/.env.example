# PostgreSQL — লোকালে, অথবা Neon / Supabase-এর ফ্রি ডেটাবেস
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/doctoros"

# লগইন সেশনের গোপন চাবি — কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম লেখা (openssl rand -base64 32)
SESSION_SECRET=""

# /api/cron/followups কল করার গোপন চাবি (Vercel Cron নিজে থেকে পাঠায়)
CRON_SECRET=""

# সাইটের আসল ঠিকানা — এসএমএসের লিংকে বসে
APP_URL="http://localhost:3000"

# এসএমএস: "console" = শুধু লগ (টেস্ট), "http" = আসল গেটওয়ে
SMS_PROVIDER="console"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# "1" দিলে সিরিয়াল আসতে ২ জন বাকি থাকলে রোগীকে এসএমএস (খরচ বাড়বে)
QUEUE_SMS_ALERT="0"

# ডেমো: "1" দিলে সব নাম্বারের OTP স্ক্রিনে দেখায় — আসল রোগী আসার আগে অবশ্যই মুছুন
OTP_DEMO_ALL=""

# Premium লঞ্চ অফার: "0" দিলে সবার জন্য ফ্রি বন্ধ — তখন শুধু plan=PREMIUM ডাক্তারের ওয়েবসাইট দেখাবে
PREMIUM_FREE_FOR_ALL=""
# অফার কবে শেষ (দেখানোর জন্য), যেমন 2027-06-30
PREMIUM_FREE_UNTIL=""

# ডেমো ডাক্তার/রোগী: খালি = বিল্ডের সময় তৈরি, "0" = কিছু করবে না, "remove" = মুছে ফেলবে
DEMO_DATA=""
