# PostgreSQL — লোকালে, অথবা Neon / Supabase-এর ফ্রি ডেটাবেস
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/doctoros"

# লগইন সেশনের গোপন চাবি — কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম লেখা (openssl rand -base64 32)
SESSION_SECRET=""

# /api/cron/followups কল করার গোপন চাবি (Vercel Cron নিজে থেকে পাঠায়)
CRON_SECRET=""

# সাইটের আসল ঠিকানা — এসএমএসের লিংকে বসে
APP_URL="http://localhost:3000"

# এসএমএস: "console" = শুধু লগ (টেস্ট), "http" = আসল গেটওয়ে
SMS_PROVIDER="console"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# "1" দিলে সিরিয়াল আসতে ২ জন বাকি থাকলে রোগীকে এসএমএস (খরচ বাড়বে)
QUEUE_SMS_ALERT="0"
